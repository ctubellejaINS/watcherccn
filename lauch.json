{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug npm start",
      "runtimeExecutable": "npm", // Tells VS Code to look for npm instead of Node
      "runtimeArgs": ["run", "start"], // Passes the 'run start' command flags
      "cwd": "${workspaceFolder}",
      "sourceMaps": true
    }
  ]
}
